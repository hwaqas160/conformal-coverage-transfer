diff --git a/unitraj/models/autobot/autobot.py b/unitraj/models/autobot/autobot.py
index 46c9d2b..60a5e13 100644
--- a/unitraj/models/autobot/autobot.py
+++ b/unitraj/models/autobot/autobot.py
@@ -72,7 +72,10 @@ class MapEncoderPts(nn.Module):
 
     def get_road_pts_mask(self, roads):
         road_segment_mask = torch.sum(roads[:, :, :, -1], dim=2) == 0
-        road_pts_mask = (1.0 - roads[:, :, :, -1]).type(torch.BoolTensor).to(roads.device).view(-1, roads.shape[2])
+        # Paper-01 patch (2026-09-23): was `.type(torch.BoolTensor).to(roads.device)` -- torch.BoolTensor is a CPU
+        # type, so every step copied the map mask GPU->CPU->GPU with a sync (0.24 s of a 0.43 s GPU step).
+        # `.bool()` is the same conversion on-device; verified torch.equal(old, new) on a real batch.
+        road_pts_mask = (1.0 - roads[:, :, :, -1]).bool().view(-1, roads.shape[2])
         road_pts_mask = road_pts_mask.masked_fill((road_pts_mask.sum(-1) == roads.shape[2]).unsqueeze(-1), False) # Ensures no NaNs due to empty rows.
         return road_segment_mask, road_pts_mask
 
